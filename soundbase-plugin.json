{
  "manifestVersion": 1,
  "id": "rsa306b",
  "name": "Tektronix RSA306B",
  "version": "1.0.0",
  "license": "MIT",
  "platforms": [
    "darwin-arm64",
    "win32-x64"
  ],
  "repository": "https://github.com/kjungk/rsa306b-plugin",
  "maintainers": [
    {
      "name": "Kevin Jungk",
      "url": "https://github.com/kjungk"
    }
  ],
  "contract": {
    "core": "1.4",
    "modules": {
      "SpectrumAnalyzer": "1.2"
    }
  },
  "runtime": {
    "type": "node",
    "entrypoint": "main.js"
  },
  "deployment": [
    "managed"
  ],
  "products": [
    {
      "deviceTypeId": "plugin:rsa306b/rsa306b",
      "manufacturer": {
        "id": "tektronix",
        "name": "Tektronix"
      },
      "model": {
        "id": "rsa306b",
        "name": "RSA306B",
        "displayName": "Tektronix RSA306B"
      },
      "family": {
        "id": "rsa",
        "name": "RSA"
      },
      "capabilities": {
        "spectrumAnalyzer": true
      },
      "traits": {
        "isSpectrumAnalyzer": true
      }
    }
  ],
  "pluginConfigFields": [
    {
      "id": "windowsBackend",
      "type": "dropdown",
      "label": "Windows acquisition backend",
      "default": "native",
      "choices": [
        {
          "id": "native",
          "label": "Native USB (default)"
        },
        {
          "id": "tektronix-api",
          "label": "Tektronix API (fallback)"
        }
      ],
      "help": "Windows only; leave on Native USB for normal use. Install the Tektronix RSA USB driver using SignalVu-PC or the RSA API installer. Native USB does not use the Tektronix API library; the fallback requires it. Close live scans before switching. macOS always uses the bundled native worker."
    }
  ],
  "stateKeys": [],
  "deviceConfigFields": [
    {
      "id": "serial",
      "type": "textinput",
      "label": "Analyzer serial number",
      "manualOnly": true,
      "help": "Only needed when adding a device manually. Selecting a discovered analyzer supplies its serial number automatically."
    }
  ]
}
